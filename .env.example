# document-extractor configuration. Copy to .env and edit.
# Placeholder values only. Never commit real keys.

# Choose a backend: "api" (any OpenAI-compatible endpoint) or "hf" (open models via transformers)
MS_BACKEND=hf

# --- (a) api: bring your own key, any OpenAI-compatible endpoint ---
MS_API_BASE=https://your-provider.example/v1
MS_API_KEY=your-api-key
MS_MODEL=your-chat-model
# Optional: a vision-capable model on the same endpoint, used for OCR of scanned pages
MS_VISION_MODEL=
# Optional: an embedding model on the same endpoint for Q&A retrieval (BM25 is used if empty)
MS_EMBED_MODEL=

# --- (b) hf: open-source models from Hugging Face, run locally with transformers ---
# Qwen2.5-7B-Instruct needs a GPU or ~32 GB RAM. On a CPU-only machine use the 1.5B model.
MS_HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# MS_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
MS_HF_EMBED_MODEL=BAAI/bge-m3
MS_HF_OCR_MODEL=florence-community/Florence-2-large
# HF_TOKEN=your-hf-token   # only needed for gated models

# --- shared ---
# Q&A retrieval: auto (embeddings when available, else BM25) | embed | bm25
MS_RETRIEVER=auto
# Where the web demo keeps saved results
MS_CACHE_DIR=.cache/results
